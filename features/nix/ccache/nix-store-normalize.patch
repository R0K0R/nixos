+TEST_CASE("core::find_foreign_nix_store_reference")
+{
+  const std::string h1 = "1111111111111111111111111111111a";
+  const std::string h2 = "2222222222222222222222222222222b";
+  std::string h1_upper = h1;
+  h1_upper.back() = 'A';
+  core::NixStoreObjects objects;
+  core::remember_nix_store_objects(
+    objects, FMT("/nix/store/{}-dep-hdr/include/dep.h", h2));
+  core::remember_nix_store_objects(
+    objects, FMT("/nix/store/{}-glibc-dev/include/stdio.h", h1));
+
+  const auto find = [&](const std::string& data) {
+    return core::find_foreign_nix_store_reference(data, &objects);
+  };
+  const std::string nul(1, '\0');
+
+  // This compilation's own paths, plain and mangled.
+  CHECK(!find("x" + nul + "/nix/store/" + h2 + "-dep-hdr/include/dep.h" + nul));
+  CHECK(!find(FMT("/nix/store/{}-glibc-dev/include/stdio.h", h1_upper)));
+  // The same name with another hash, plain and mangled.
+  CHECK(find(nul + "/nix/store/" + h1 + "-dep-hdr/include/dep.h" + nul)
+        == FMT("/nix/store/{}-dep-hdr", h1));
+  CHECK(find(FMT("/nix/store/{}-dep-hdr/include/dep.h", h1_upper))
+        == FMT("/nix/store/{}-dep-hdr", h1_upper));
+  // Unrelated store objects (e.g. the package's own $out) and the clang
+  // wrapper's -fmacro-prefix-map form never count.
+  CHECK(!find(FMT("/nix/store/{}-mypkg-1.0/share", h1)));
+  CHECK(!find("/nix/store/eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee-dep-hdr/include/x.h"));
+  // A longer name is another store object.
+  CHECK(!find(FMT("/nix/store/{}-dep-hdr-extra/x.h", h1)));
+  // Not a hash: mixed case, short, no dash.
+  CHECK(!find("/nix/store/111111111111111111111111111111aA-dep-hdr"));
+  CHECK(!find("/nix/store/1111-dep-hdr"));
+  // Without a map every store reference counts.
+  CHECK(core::find_foreign_nix_store_reference(
+    FMT("/nix/store/{}-mypkg-1.0/share", h1), nullptr));
+  CHECK(!core::find_foreign_nix_store_reference("no store paths", nullptr));
+}
