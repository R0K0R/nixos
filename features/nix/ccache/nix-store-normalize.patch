+TEST_CASE("depfile::rewrite_nix_store_paths")
+{
+  const std::string h1 = "1111111111111111111111111111111a";
+  const std::string h2 = "2222222222222222222222222222222b";
+  const std::string h3 = "3333333333333333333333333333333c";
+  const std::string zero = "00000000000000000000000000000000";
+  const auto store = [](const std::string& hash, std::string_view rest) {
+    return FMT("/nix/store/{}-{}", hash, rest);
+  };
+
+  core::NixStorePaths paths;
+  core::remember_nix_store_path(paths,
+                                store(zero, "dbus-dev/include/dbus/dbus.h"),
+                                store(h2, "dbus-dev/include/dbus/dbus.h"));
+  core::remember_nix_store_path(paths,
+                                store(zero, "zlib-dev/include/zlib.h"),
+                                store(h1, "zlib-dev/include/zlib.h"));
+
+  SUBCASE("store paths are replaced, every other byte is kept")
+  {
+    const auto content = FMT(
+      "/nix/store/{0}-out/foo.o: foo.c \\\n"
+      "  {1}   {2} \\\n"
+      " /build/x.h\n"
+      "\n"
+      "{1}:\n"
+      "\n"
+      "{2}:\n",
+      h3,
+      store(h1, "dbus-dev/include/dbus/dbus.h"),
+      store(h1, "zlib-dev/include/zlib.h"));
+    const auto result = depfile::rewrite_nix_store_paths(content, paths);
+    REQUIRE(result);
+    REQUIRE(*result);
+    CHECK(**result
+          == FMT("/nix/store/{0}-out/foo.o: foo.c \\\n"
+                 "  {1}   {2} \\\n"
+                 " /build/x.h\n"
+                 "\n"
+                 "{1}:\n"
+                 "\n"
+                 "{2}:\n",
+                 h3,
+                 store(h2, "dbus-dev/include/dbus/dbus.h"),
+                 store(h1, "zlib-dev/include/zlib.h")));
+  }
+
+  SUBCASE("nothing to replace")
+  {
+    const auto content =
+      FMT("foo.o: foo.c {}\n", store(h1, "zlib-dev/include/zlib.h"));
+    const auto result = depfile::rewrite_nix_store_paths(content, paths);
+    REQUIRE(result);
+    CHECK(!*result);
+  }
+
+  SUBCASE("no counterpart is an error")
+  {
+    const auto content =
+      FMT("foo.o: foo.c {}\n", store(h1, "dbus-dev/include/dbus/other.h"));
+    const auto result = depfile::rewrite_nix_store_paths(content, paths);
+    REQUIRE(!result);
+    CHECK(result.error().find("dbus/other.h") != std::string::npos);
+    CHECK(!depfile::rewrite_nix_store_paths(content, {}));
+  }
+
+  SUBCASE("ambiguous counterpart is an error")
+  {
+    core::remember_nix_store_path(paths,
+                                  store(zero, "zlib-dev/include/zlib.h"),
+                                  store(h3, "zlib-dev/include/zlib.h"));
+    const auto content =
+      FMT("foo.o: foo.c {}\n", store(h1, "zlib-dev/include/zlib.h"));
+    CHECK(!depfile::rewrite_nix_store_paths(content, paths));
+  }
+
+  SUBCASE("escaped characters")
+  {
+    core::remember_nix_store_path(paths,
+                                  store(zero, "x/include/a b.h"),
+                                  store(h2, "x/include/a b.h"));
+    const auto content =
+      FMT("foo.o: {}\n", store(h1, "x/include/a\\ b.h"));
+    const auto result = depfile::rewrite_nix_store_paths(content, paths);
+    REQUIRE(result);
+    REQUIRE(*result);
+    CHECK(**result == FMT("foo.o: {}\n", store(h2, "x/include/a\\ b.h")));
+  }
+}
