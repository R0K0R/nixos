+
+// Replace the hash of each /nix/store/<32-char hash>-<name> in `path` with a
+// placeholder.
+std::string nix_store_normalize(std::string_view path);
+
+// Record that this compilation uses `path`, whose normalized form is
+// `normalized`.
+void remember_nix_store_path(NixStorePaths& paths,
+                             std::string_view normalized,
+                             std::string_view path);
+
+// Store objects (/nix/store/<placeholder>-<name>) of this compilation's
+// line-marker paths -> the hashes this compilation uses for each.
+using NixStoreObjects =
+  std::unordered_map<std::string, std::unordered_set<std::string>>;
+
+// Record the store objects referenced by `path`, which this compilation uses.
+void remember_nix_store_objects(NixStoreObjects& objects,
+                                std::string_view path);
+
+// Find a reference in `data` (a restored object file or other binary output)
+// to a store object that has the same name as one in `objects` but a hash this
+// compilation does not use -- in plain form or in the uppercased-hash form
+// nixpkgs' gcc gives __FILE__ and __builtin_FILE(). With `objects` null, any
+// store reference counts. Hashes that cannot be real (outside Nix's base32
+// alphabet, e.g. the eeee... that nixpkgs' clang wrapper maps headers to) are
+// ignored. Returns the reference found, if any.
+std::optional<std::string>
+find_foreign_nix_store_reference(std::string_view data,
+                                 const NixStoreObjects* objects);
+
+// Replace each store path in free text (stderr) that has an unambiguous
+// counterpart in `paths` with that counterpart. Anything else is left as is.
+// Returns std::nullopt if nothing was replaced.
+std::optional<std::string>
+rewrite_nix_store_paths_in_text(std::string_view text,
+                                const NixStorePaths& paths);
+
 } // namespace core
