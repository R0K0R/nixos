+// Nix store path normalisation, for cross-derivation cache reuse.
+//
+// In Nix every build input lives at /nix/store/<32-char hash>-<name>, and that
+// hash changes whenever anything about the input's derivation changes, even
+// when the installed headers are byte-identical. The preprocessed output then
+// carries a different `# N "/nix/store/<hash>-foo/include/x.h"` line marker for
+// what is, as far as the compilation is concerned, the same input, so every
+// dependent misses after any dependency is rebuilt, however trivially.
+//
+// Eliding just the hash lets those compilations share a cache entry. It stays
+// sound because the include file's CONTENT is still hashed: in preprocessor
+// mode it is the preprocessed text itself, in direct mode
+// remember_include_file() hashes each file. Headers that actually differ still
+// produce different results. Only the location is forgotten.
+//
+// Deliberately narrow: it rewrites the include path ccache extracts from a line
+// marker and nothing else, notably not string literals, which may legitimately
+// contain a store path. A package compiled with
+// -DDATADIR="/nix/store/<own out>/share" must not share entries with another.
+//
+// Off unless CCACHE_NIX_STORE_NORMALIZE is set, and suppressed whenever the
+// compilation produces an output that records include file locations, since a
+// reused result would then name a store path outside the consuming
+// derivation's closure: debug info (DWARF records include directories), a
+// precompiled header, coverage notes (.gcno), stack usage (.su), call graph
+// info (.ci), IPA clones and clang's serialized/SARIF diagnostics. Those all
+// name the header that defines an inline function or holds a diagnostic.
+//
+// Forgetting the location has one consequence that must be undone on a hit:
+// the result's dependency file (-MD and friends) was written by the
+// compilation that STORED the entry, so it names that compilation's store
+// paths. Most build systems never notice, but some validate it -- waf's
+// gccdeps fails samba's configure with "could not find
+// '/nix/store/<old hash>-dbus-dev/include/dbus-1.0/dbus/dbus.h'". So while
+// hashing, every line-marker path that normalization changed is remembered
+// (ctx.nix_store_paths: normalized -> the real path), and from_cache() rewrites
+// each store path in the restored dependency file to the path THIS compilation
+// uses with the same normalized form. When a store path in the dependency file
+// has no such counterpart (or two of them), ccache does not guess: the hit is
+// treated as a miss and the compiler runs. That includes every direct mode
+// hit, which never ran the preprocessor; it falls through to preprocessor
+// mode, which then has the map. The stderr text of the result is rewritten
+// with the same map, but best-effort only: it is free text, so paths without a
+// counterpart are left alone rather than forcing a miss.
+//
+// Binary outputs cannot be rewritten that way, and one hole remains in them:
+// __builtin_FILE() and std::source_location::current() are resolved by the
+// compiler from the line markers, so a header path they put into the object
+// never appears in the preprocessed text and the key cannot tell two store
+// hashes apart. (__FILE__ is fine: it expands in the text, hence in the key.)
+// So before a hit is accepted, every restored file other than stderr and the
+// dependency file is scanned, decompressed and in memory, for a reference to
+// a store object that has the same name as one of this compilation's include
+// store objects (ctx.nix_store_objects) but another hash -- in plain form, or
+// with the hash uppercased, which is what nixpkgs' gcc
+// (mangle-NIX_STORE-in-__FILE__.patch) writes for __FILE__ and
+// __builtin_FILE(). Such a hit is a miss. nixpkgs' clang wrapper instead maps
+// each include dir to /nix/store/eeee...-<name> with -fmacro-prefix-map; that
+// is the same for every hash and not a valid hash, so it is ignored. Store
+// paths of objects this compilation does not include from (the package's own
+// $out in a string literal, already part of the key) never count. A direct
+// mode hit has no line markers to compare with, so there any store reference
+// sends it to preprocessor mode.
+bool
+nix_store_normalize_enabled()
+{
+  static const bool enabled = getenv("CCACHE_NIX_STORE_NORMALIZE") != nullptr;
+  return enabled;
+}
+
+bool
+nix_store_normalize_applies(const Context& ctx)
+{
+  const auto& ai = ctx.args_info;
+  return nix_store_normalize_enabled() && !ai.generating_debuginfo
+         && !ai.generating_pch && !ai.generating_coverage
+         && !ai.generating_stackusage && !ai.generating_callgraphinfo
+         && !ai.generating_ipa_clones && ai.output_dia.empty()
+         && ai.output_sarif.empty();
+}
+
+std::string
+nix_store_normalize(std::string_view path)
+{
+  static constexpr std::string_view k_prefix = "/nix/store/";
+  static constexpr size_t k_hash_len = 32;
+  static constexpr std::string_view k_placeholder =
+    "00000000000000000000000000000000";
+
+  std::string result;
+  size_t pos = 0;
+  while (pos < path.size()) {
+    const size_t at = path.find(k_prefix, pos);
+    if (at == std::string_view::npos) {
+      result.append(path.substr(pos));
+      break;
+    }
+    result.append(path.substr(pos, at - pos + k_prefix.size()));
+    const size_t hash_start = at + k_prefix.size();
+    size_t i = hash_start;
+    while (i < path.size() && i - hash_start < k_hash_len
+           && ((path[i] >= 'a' && path[i] <= 'z')
+               || (path[i] >= '0' && path[i] <= '9'))) {
+      ++i;
+    }
+    if (i - hash_start == k_hash_len && i < path.size() && path[i] == '-') {
+      result.append(k_placeholder);
+      pos = i;
+    } else {
+      pos = hash_start;
+    }
+  }
+  return result;
+}
+
+void
+remember_nix_store_path(NixStorePaths& paths,
+                        std::string_view normalized,
+                        std::string_view path)
+{
+  const auto [it, inserted] =
+    paths.emplace(std::string(normalized), std::string(path));
+  if (!inserted && it->second != path) {
+    it->second.clear(); // Ambiguous.
+  }
+}
+
+namespace {
+
+constexpr std::string_view k_nix_store_prefix = "/nix/store/";
+constexpr size_t k_nix_store_hash_len = 32;
+
+struct NixStoreReference
+{
+  std::string hash; // lowercased
+  std::string object; // /nix/store/<placeholder>-<name>
+  size_t end;         // just past <name>
+};
+
+bool
+is_nix_store_name_char(char c)
+{
+  return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+         || (c >= '0' && c <= '9') || c == '+' || c == '-' || c == '.'
+         || c == '_' || c == '?' || c == '=';
+}
+
+// Parse a store object reference at `pos` (which points at /nix/store/). The
+// hash may be all lowercase (as Nix writes it) or all uppercase (nixpkgs' gcc
+// mangling of __FILE__); it must be in Nix's base32 alphabet, which has no e,
+// o, u or t.
+std::optional<NixStoreReference>
+parse_nix_store_reference(std::string_view text, size_t pos)
+{
+  const size_t hash_start = pos + k_nix_store_prefix.size();
+  const size_t dash = hash_start + k_nix_store_hash_len;
+  if (dash >= text.size() || text[dash] != '-') {
+    return std::nullopt;
+  }
+  bool lower = false;
+  bool upper = false;
+  std::string hash;
+  hash.reserve(k_nix_store_hash_len);
+  for (size_t i = hash_start; i < dash; ++i) {
+    char c = text[i];
+    if (c >= 'A' && c <= 'Z') {
+      upper = true;
+      c = static_cast<char>(c - 'A' + 'a');
+    } else if (c >= 'a' && c <= 'z') {
+      lower = true;
+    } else if (!(c >= '0' && c <= '9')) {
+      return std::nullopt;
+    }
+    if (c == 'e' || c == 'o' || c == 'u' || c == 't') {
+      return std::nullopt;
+    }
+    hash += c;
+  }
+  if (lower && upper) {
+    return std::nullopt;
+  }
+  size_t end = dash + 1;
+  while (end < text.size() && is_nix_store_name_char(text[end])) {
+    ++end;
+  }
+  if (end == dash + 1) {
+    return std::nullopt;
+  }
+  NixStoreReference ref;
+  ref.hash = std::move(hash);
+  ref.object = FMT("{}{}{}",
+                   k_nix_store_prefix,
+                   std::string(k_nix_store_hash_len, '0'),
+                   text.substr(dash, end - dash));
+  ref.end = end;
+  return ref;
+}
+
+} // namespace
+
+void
+remember_nix_store_objects(NixStoreObjects& objects, std::string_view path)
+{
+  for (size_t pos = path.find(k_nix_store_prefix);
+       pos != std::string_view::npos;
+       pos = path.find(k_nix_store_prefix, pos + 1)) {
+    if (auto ref = parse_nix_store_reference(path, pos)) {
+      objects[ref->object].insert(ref->hash);
+    }
+  }
+}
+
+std::optional<std::string>
+find_foreign_nix_store_reference(std::string_view data,
+                                 const NixStoreObjects* objects)
+{
+  for (size_t pos = data.find(k_nix_store_prefix);
+       pos != std::string_view::npos;
+       pos = data.find(k_nix_store_prefix, pos + 1)) {
+    const auto ref = parse_nix_store_reference(data, pos);
+    if (!ref) {
+      continue;
+    }
+    if (!objects) {
+      return std::string(data.substr(pos, ref->end - pos));
+    }
+    const auto it = objects->find(ref->object);
+    if (it != objects->end() && !it->second.contains(ref->hash)) {
+      return std::string(data.substr(pos, ref->end - pos));
+    }
+  }
+  return std::nullopt;
+}
+
+std::optional<std::string>
+rewrite_nix_store_paths_in_text(std::string_view text,
+                                const NixStorePaths& paths)
+{
+  static constexpr std::string_view k_prefix = "/nix/store/";
+  const auto is_path_char = [](char c) {
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
+           || (c >= '0' && c <= '9') || c == '/' || c == '.' || c == '-'
+           || c == '_' || c == '+' || c == '=' || c == '?' || c == '~';
+  };
+
+  std::string result;
+  size_t copied = 0;
+  size_t pos = 0;
+  while ((pos = text.find(k_prefix, pos)) != std::string_view::npos) {
+    size_t end = pos + k_prefix.size();
+    while (end < text.size() && is_path_char(text[end])) {
+      ++end;
+    }
+    const auto path = text.substr(pos, end - pos);
+    const auto it = paths.find(nix_store_normalize(path));
+    if (it != paths.end() && !it->second.empty() && it->second != path) {
+      result.append(text.substr(copied, pos - copied));
+      result.append(it->second);
+      copied = end;
+    }
+    pos = end;
+  }
+  if (copied == 0) {
+    return std::nullopt;
+  }
+  result.append(text.substr(copied));
+  return result;
+}
+
 } // namespace core
