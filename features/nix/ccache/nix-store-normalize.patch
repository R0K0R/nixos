+
+// Normalized store path -> the path this compilation actually uses, collected
+// from the preprocessor's line markers. An empty value means the normalized
+// path is ambiguous: two different paths of this compilation map to it.
+using NixStorePaths = std::unordered_map<std::string, std::string>;
