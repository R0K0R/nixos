+TEST_CASE("core::nix_store_normalize")
+{
+  const std::string zero = "00000000000000000000000000000000";
+  CHECK(core::nix_store_normalize("") == "");
+  CHECK(core::nix_store_normalize("/usr/include/x.h") == "/usr/include/x.h");
+  CHECK(core::nix_store_normalize(
+          "/nix/store/0123456789abcdfghijklmnpqrsvwxyz-zlib-dev/include/zlib.h")
+        == FMT("/nix/store/{}-zlib-dev/include/zlib.h", zero));
+  // Too short a hash, or no dash after it: not a store path.
+  CHECK(core::nix_store_normalize("/nix/store/0123-zlib")
+        == "/nix/store/0123-zlib");
+  CHECK(core::nix_store_normalize(
+          "/nix/store/0123456789abcdfghijklmnpqrsvwxyz/zlib")
+        == "/nix/store/0123456789abcdfghijklmnpqrsvwxyz/zlib");
+}
+
+TEST_CASE("core::rewrite_nix_store_paths_in_text")
+{
+  const std::string zero = "00000000000000000000000000000000";
+  const std::string h1 = "1111111111111111111111111111111a";
+  const std::string h2 = "2222222222222222222222222222222b";
+  core::NixStorePaths paths;
+  core::remember_nix_store_path(paths,
+                                FMT("/nix/store/{}-z/include/z.h", zero),
+                                FMT("/nix/store/{}-z/include/z.h", h2));
+
+  CHECK(!core::rewrite_nix_store_paths_in_text("no paths\n", paths));
+  CHECK(!core::rewrite_nix_store_paths_in_text(
+    FMT("/nix/store/{}-z/include/z.h:1:2: warning\n", h2), paths));
+  // Unknown paths are left alone in free text.
+  CHECK(!core::rewrite_nix_store_paths_in_text(
+    FMT("/nix/store/{}-z/include/other.h:1: x\n", h1), paths));
+  CHECK(core::rewrite_nix_store_paths_in_text(
+          FMT("In file included from \x1b[01m/nix/store/{0}-z/include/z.h:3"
+              "\x1b[m,\n/nix/store/{0}-z/include/z.h:1:2: warning: x\n",
+              h1),
+          paths)
+        == FMT("In file included from \x1b[01m/nix/store/{0}-z/include/z.h:3"
+               "\x1b[m,\n/nix/store/{0}-z/include/z.h:1:2: warning: x\n",
+               h2));
+}
+
