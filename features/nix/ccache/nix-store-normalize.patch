+class NixStorePathCollector : public core::result::Deserializer::Visitor
+{
+public:
+  NixStorePathCollector(const Context& ctx,
+                        const Hash::Digest& result_key,
+                        const core::NixStoreObjects* objects)
+    : m_ctx(ctx),
+      m_result_key(result_key),
+      m_objects(objects)
+  {
+  }
+
+  std::optional<std::string> dependency_file;
+  std::optional<std::string> stderr_output;
+  std::optional<std::string> foreign_reference; // "<file type>: <path>"
+  uint64_t scanned_bytes = 0;
+
+  void
+  on_embedded_file(uint8_t /*file_number*/,
+                   core::result::FileType file_type,
+                   std::span<const uint8_t> data) override
+  {
+    if (file_type == core::result::FileType::dependency) {
+      dependency_file = std::string(util::to_string_view(data));
+    } else if (file_type == core::result::FileType::stderr_output) {
+      stderr_output = std::string(util::to_string_view(data));
+    } else {
+      scan(file_type, util::to_string_view(data));
+    }
+  }
+
+  void
+  on_raw_file(uint8_t file_number,
+              core::result::FileType file_type,
+              uint64_t /*file_size*/) override
+  {
+    const auto path =
+      m_ctx.storage.local.get_raw_file_path(m_result_key, file_number);
+    const auto data = util::read_file<std::string>(path);
+    if (!data) {
+      foreign_reference = FMT("{}: cannot read {}: {}",
+                              core::result::file_type_to_string(file_type),
+                              path,
+                              data.error());
+      return;
+    }
+    scan(file_type, *data);
+  }
+
+private:
+  const Context& m_ctx;
+  const Hash::Digest& m_result_key;
+  const core::NixStoreObjects* m_objects;
+
+  void
+  scan(core::result::FileType file_type, std::string_view data)
+  {
+    if (foreign_reference || (m_objects && m_objects->empty())) {
+      return;
+    }
+    scanned_bytes += data.size();
+    if (auto ref = core::find_foreign_nix_store_reference(data, m_objects)) {
+      foreign_reference =
+        FMT("{} names {}", core::result::file_type_to_string(file_type), *ref);
+    }
+  }
