+tl::expected<std::optional<std::string>, std::string>
+rewrite_nix_store_paths(std::string_view content,
+                        const core::NixStorePaths& paths)
+{
+  // Same token rules as tokenize() below, but working on spans of `content`
+  // so that a replaced path is the only thing that changes.
+  std::string result;
+  size_t copied = 0; // content[0, copied) is in result
+  bool rewritten = false;
+  bool in_first_targets = true;
+
+  const size_t length = content.size();
+  size_t i = 0;
+  while (i < length) {
+    if (util::is_space(content[i])) {
+      ++i;
+      continue;
+    }
+    if (content[i] == '\\' && i + 1 < length && content[i + 1] == '\n') {
+      i += 2; // Line continuation.
+      continue;
+    }
+    if (content[i] == ':') {
+      in_first_targets = false;
+      ++i;
+      continue;
+    }
+
+    const size_t start = i;
+    std::string token;
+    while (i < length) {
+      if (content[i] == ':' && token.length() == 1
+          && !util::is_space(token[0]) && i + 1 < length
+          && (content[i + 1] == '/' || content[i + 1] == '\\')) {
+        token += content[i]; // Windows path.
+        ++i;
+        continue;
+      }
+      if (content[i] == ':' || util::is_space(content[i])
+          || (content[i] == '\\' && i + 1 < length
+              && content[i + 1] == '\n')) {
+        break;
+      }
+      if (i + 1 < length) {
+        if (content[i] == '\\'
+            && (content[i + 1] == '\\' || content[i + 1] == '#'
+                || content[i + 1] == ':' || content[i + 1] == ' '
+                || content[i + 1] == '\t')) {
+          ++i;
+        } else if (content[i] == '$' && content[i + 1] == '$') {
+          ++i;
+        }
+      }
+      token += content[i];
+      ++i;
+    }
+
+    if (in_first_targets) {
+      // The object file. ResultRetriever replaces it with this compilation's
+      // target anyway.
+      continue;
+    }
+    const std::string normalized = core::nix_store_normalize(token);
+    if (normalized == token) {
+      continue; // Not a store path.
+    }
+    const auto it = paths.find(normalized);
+    if (it == paths.end()) {
+      return tl::unexpected(
+        FMT("{} has no counterpart among this compilation's include files",
+            token));
+    }
+    if (it->second.empty()) {
+      return tl::unexpected(FMT(
+        "{} matches more than one include file of this compilation", token));
+    }
+    if (it->second != token) {
+      result.append(content.substr(copied, start - copied));
+      result.append(escape_filename(it->second));
+      copied = i;
+      rewritten = true;
+    }
+  }
+
+  if (!rewritten) {
+    return std::nullopt;
+  }
+  result.append(content.substr(copied));
+  return result;
+}
+
 std::vector<std::string>
 tokenize(std::string_view text)
 {
