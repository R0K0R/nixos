+/// Set a hit's times to now. Setting an explicit time (set_file_times) is
+/// for the file's owner only, so a hit on an entry another user wrote -- a
+/// shared cache directory's normal case -- failed with EPERM and became a
+/// cache error. A NULL time means "now" and needs only write access.
+#[cfg(unix)]
+fn touch(path: &Path) -> io::Result<()> {
+    use std::os::unix::ffi::OsStrExt;
+    let c = std::ffi::CString::new(path.as_os_str().as_bytes())?;
+    if unsafe { libc::utimensat(libc::AT_FDCWD, c.as_ptr(), std::ptr::null(), 0) } == 0 {
+        Ok(())
+    } else {
+        Err(io::Error::last_os_error())
+    }
+}
+
+#[cfg(not(unix))]
+fn touch(path: &Path) -> io::Result<()> {
+    let t = FileTime::now();
+    set_file_times(path, t, t)
+}
+
