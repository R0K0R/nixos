# bonfire boot splash -- the campfire mark centered on a dark ground, breathing like embers.
# A script-module theme (no two-step frames): the machines that use this have no LUKS, so there is no password
# dialog to honour here; keep it to the logo + boot messages.

Window.SetBackgroundTopColor(0.07, 0.05, 0.04);
Window.SetBackgroundBottomColor(0.03, 0.02, 0.02);

logo.image = Image("logo.png");
logo.w = logo.image.GetWidth();
logo.h = logo.image.GetHeight();
logo.x = Window.GetWidth() / 2 - logo.w / 2;
logo.y = Window.GetHeight() / 2 - logo.h / 2;
logo.sprite = Sprite(logo.image);
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(10);

# gentle ember pulse on the logo opacity
tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.70 + 0.30 * Math.Sin(tick / 20));
}
Plymouth.SetRefreshFunction(refresh_callback);

# boot messages (fsck etc.) just under the mark
message.sprite = Sprite();
fun message_callback(text) {
    message.image = Image.Text(text, 0.85, 0.55, 0.35);
    message.sprite.SetImage(message.image);
    message.sprite.SetX(Window.GetWidth() / 2 - message.image.GetWidth() / 2);
    message.sprite.SetY(logo.y + logo.h + 28);
}
Plymouth.SetMessageFunction(message_callback);
