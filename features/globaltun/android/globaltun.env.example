# Copy to globaltun.env beside globaltun-termux.sh and edit.
#   cp globaltun.env.example globaltun.env
#
# Termux only -- no root, no routing. The sing-box app does the tun half.

# --- the gateway: the phone/box running rsocks.py, as reached FROM the jump ---
export GT_RHOST=root@192.168.0.100
export GT_RPORT=8022

# --- jump host --------------------------------------------------------------
# Leave commented out ONLY if this phone can reach GT_RHOST directly. On a
# network that cannot (the usual case, and the reason the tunnel exists), set
# it: the key below is handed to this hop explicitly, because `ssh -J` would
# not pass it and would fall back to password auth on every connection.
#export GT_JUMP=user@jump.example
#export GT_JUMP_TIMEOUT=120

# --- key --------------------------------------------------------------------
# Must authenticate to BOTH hops. Generate one on the phone and add the public
# half to authorized_keys on the jump host and the gateway:
#   ssh-keygen -t ed25519 -f ~/.ssh/globaltun -N ""
# Termux has no /etc; keep it under the Termux home and chmod 600.
export GT_KEY=/data/data/com.termux/files/home/.ssh/globaltun

# --- relay port ON THE GATEWAY ----------------------------------------------
# Unique per client, no default. Two clients sharing one means whichever runs
# `up` last kills the other's relay and every connection on it, silently.
# Taken: 1080 1081 1082 1083. 1084 is allocated to the first Android client.
export GT_REMOTE_SOCKS_PORT=1084

# --- local ports ------------------------------------------------------------
# GT_LOCAL_PORT is what the sing-box app's socks outbound points at, so it must
# match "server_port" in sing-box-android.json. GT_LPORT is the local end of
# the ssh -L forward and only matters if something else already uses it.
export GT_LOCAL_PORT=1081
export GT_LPORT=11080
