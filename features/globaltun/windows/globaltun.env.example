# Copy to globaltun.env beside globaltun-windows.ps1 and edit.
#   copy globaltun.env.example globaltun.env
#
# Same format as the Linux and Android bundles. `export` is optional and
# ignored here; it is kept so one file can be shared between platforms.

# --- the gateway, as reached FROM the jump ---------------------------------
GT_RHOST=root@192.168.0.100
GT_RPORT=8022

# --- jump host --------------------------------------------------------------
# Omit only if this machine can reach GT_RHOST directly. The key below is
# handed to this hop explicitly, because `ssh -J` would not pass it and would
# fall back to password auth on every connection.
#GT_JUMP=user@jump.example

# --- key --------------------------------------------------------------------
# Must authenticate to BOTH hops. Windows OpenSSH is strict about permissions:
# the file must not be readable by anyone but you, or ssh refuses it.
#   icacls %USERPROFILE%\.ssh\globaltun /inheritance:r /grant:r "%USERNAME%:R"
GT_KEY=C:\Users\you\.ssh\globaltun

# --- relay port ON THE GATEWAY ----------------------------------------------
# Unique per client, no default. Two clients sharing one means whichever runs
# `up` last kills the other's relay and every connection on it, silently.
# Taken: 1080 1081 1082 1083 1084. 1085 is the next free.
GT_REMOTE_SOCKS_PORT=1085

# --- local ports ------------------------------------------------------------
# GT_LOCAL_PORT must match "server_port" of the socks outbound in
# sing-box-windows.json. GT_LPORT is the local end of the ssh -L forward.
GT_LOCAL_PORT=1081
GT_LPORT=11080

# --- binaries ---------------------------------------------------------------
# sing-box.exe from the official Windows release. wintun.dll MUST sit beside
# it, or the tun cannot be created and sing-box exits immediately.
GT_SINGBOX=C:\tools\sing-box\sing-box.exe
GT_PYTHON=python
