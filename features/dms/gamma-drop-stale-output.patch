+// dropAvailableOutputByRegistryName removes a wl_output from availableOutputs
+// when all that is known is its registry name, i.e. it never had (or no longer
+// has) an outputState. Mirrors what the remove handler does for outputs that do.
+func (m *Manager) dropAvailableOutputByRegistryName(name uint32) {
+	var outputID uint32
+	found := false
+	m.outputRegNames.Range(func(id uint32, reg uint32) bool {
+		if reg == name {
+			outputID, found = id, true
+			return false
+		}
+		return true
+	})
+	if !found {
+		return
+	}
+	m.outputRegNames.Delete(outputID)
+
+	var dead *wlclient.Output
+	m.availOutputsMu.Lock()
+	m.availableOutputs = slices.DeleteFunc(m.availableOutputs, func(o *wlclient.Output) bool {
+		if o != nil && o.ID() == outputID {
+			dead = o
+			return true
+		}
+		return false
+	})
+	m.availOutputsMu.Unlock()
+
+	if dead != nil && !dead.IsZombie() {
+		_ = dead.Release()
+	}
+}
