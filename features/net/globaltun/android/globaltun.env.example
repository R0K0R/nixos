# Copy to globaltun.env beside globaltun-termux.sh and edit.
#   cp globaltun.env.example globaltun.env
#
# Termux only -- no root, no routing. The sing-box app does the tun half.

# --- the gateway: whatever box has the internet, as reached from the LAST jump
# It needs nothing installed beyond sshd and a writable /tmp -- the relay is
# pushed in as a static binary if this bundle carries one for its architecture,
# and only falls back to needing python3 there if it does not.
export GT_RHOST=r0k0r@172.30.0.215
export GT_RPORT=22

# --- jumps ------------------------------------------------------------------
# Hops between this phone and the gateway, nearest first, space-separated,
# each [user@]host[:port]. Leave it commented out when the phone can reach
# GT_RHOST directly -- which is the normal case when the gateway is simply a
# machine with an uplink.
#
# The key below is handed to every hop explicitly through a generated ssh
# config, because `ssh -J` would not pass it and each hop would fall back to
# password auth on every connection.
#export GT_JUMPS="user@jump.example admin@10.0.0.9:2222"
#export GT_JUMP_TIMEOUT=120

# --- key --------------------------------------------------------------------
# Must authenticate to EVERY hop and the gateway. Generate one on the phone and
# add the public half to authorized_keys on each:
#   ssh-keygen -t ed25519 -f ~/.ssh/globaltun -N ""
# Termux has no /etc; keep it under the Termux home and chmod 600.
export GT_KEY=/data/data/com.termux/files/home/.ssh/globaltun

# --- relay port ON THE GATEWAY ----------------------------------------------
# Unique per client, no default. Two clients sharing one means whichever runs
# `up` last kills the other's relay and every connection on it, silently.
# The allocation is per gateway. On the current one: 1080 galaxybook, 1082
# victus-15, 1085 Windows. 1084 is the first Android client.
export GT_REMOTE_SOCKS_PORT=1084

# --- static relay (optional) ------------------------------------------------
# Drop a gtrelay-linux-* binary beside this file and the gateway needs nothing
# installed at all. Pick it by the GATEWAY's architecture, not the phone's --
# the phone only pushes it onward. A yulee gateway wants gtrelay-linux-amd64
# even on an arm64 phone. Both are already built on any host that has the
# feature enabled; find them there and copy one over:
#   grep -m1 GT_RELAY_DIR "$(command -v globaltun)"
#export GT_RELAY_DIR=/data/data/com.termux/files/home/globaltun

# --- local ports ------------------------------------------------------------
# GT_LOCAL_PORT is what the sing-box app's socks outbound points at, so it must
# match "server_port" in sing-box-android.json. GT_LPORT is the local end of
# the ssh -L forward and only matters if something else already uses it.
export GT_LOCAL_PORT=1081
export GT_LPORT=11080
