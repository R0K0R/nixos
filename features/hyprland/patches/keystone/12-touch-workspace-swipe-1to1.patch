Touchscreen workspace swipes follow the finger 1:1.

keystone/11 feeds touchscreen swipes into the trackpad gestures as logical-px finger
travel; the workspace swipe maps gestures:workspace_swipe_distance (touchpad units,
300) onto a whole monitor, so on a 1200px panel the workspace ran ~4x ahead of the
finger. While g_pTrackpadGestures->m_fromTouchscreen (declared by 04, set by 11) the
cumulative delta is rescaled by distance / monitor extent on the animation axis.
The touchpad and the native touch edge swipe are untouched.

diff -ruN a/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp c/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp
--- a/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp	2026-10-07 21:04:19.054843150 +0100
+++ c/src/managers/input/UnifiedWorkspaceSwipeGesture.cpp	2026-10-07 21:04:19.166881488 +0100
@@ -8,6 +8,7 @@
 #include "../../layout/space/Space.hpp"
 #include "../../layout/algorithm/Algorithm.hpp"
 #include "../../managers/fullscreen/FullscreenController.hpp"
+#include "trackpad/TrackpadGestures.hpp"
 
 bool CUnifiedWorkspaceSwipeGesture::isGestureInProgress() {
     return !!m_workspaceBegin;
@@ -66,6 +67,17 @@
     const auto   YDISTANCE     = m_monitor->m_size.y + *PWORKSPACEGAP;
     const auto   ANIMSTYLE     = m_workspaceBegin->m_renderOffset->getStyle();
     const bool   VERTANIMS     = ANIMSTYLE == "slidevert" || ANIMSTYLE.starts_with("slidefadevert");
+
+    // A touchscreen swipe fed in as a trackpad one (keystone/11) arrives as the
+    // finger's travel in logical px, while this maps workspace_swipe_distance --
+    // touchpad units, 300 by default -- onto a whole monitor: the workspace ran
+    // about four times ahead of the finger on a 1200px-tall screen. Rescale so a
+    // full monitor of finger travel is a full workspace: content under the finger
+    // stays under it. The delta is cumulative, so speed and the end() threshold
+    // see the same units the touchpad gives.
+    if (g_pTrackpadGestures->m_fromTouchscreen)
+        delta *= sc<double>(SWIPEDISTANCE) / (VERTANIMS ? YDISTANCE : XDISTANCE);
+
     const double d             = m_delta - delta;
     m_delta                    = delta;
 
