 void CMoveTrackpadGesture::begin(const ITrackpadGesture::STrackpadGestureBegin& e) {
     ITrackpadGesture::begin(e);
 
     m_window    = Desktop::focusState()->window();
     m_lastDelta = {};
+
+    m_dockSwipe = false;
+    m_dockCards.clear();
+    m_dockFront.reset();
+
+    // Side-dock pile cards (my.sidedock: tagged `dock`, not `pip`) must NOT be dragged
+    // out of the cascade. The swipe moves just THAT card, live and horizontally, under
+    // the finger; on release gestures:dock_swipe_exec decides -- cycle to the next or
+    // previous card, or spring back -- and animates the pile from where it was left.
+    // A PiP card is an ordinary floating window to this gesture and moves normally.
+    const auto WIN = m_window.lock();
+    if (!WIN || !ksTagged(WIN, "dock") || ksTagged(WIN, "pip"))
+        return;
+
+    m_window.reset();
+    m_dockSwipe = true;
+    m_dockCards.emplace_back(WIN);
+
+    // front = the on-screen pile card nearest the base (largest x), as dock.sh's curfront()
+    const auto MON = WIN->m_monitor.lock();
+    for (auto const& w : Desktop::windowState()->windows()) {
+        if (!w || !w->m_isMapped || !w->m_isFloating || w->m_monitor != WIN->m_monitor || !ksTagged(w, "dock") || ksTagged(w, "pip"))
+            continue;
+        const auto POS = w->position(Desktop::View::IGeometric::GEOMETRIC_GOAL);
+        if (MON && POS.x >= MON->m_position.x + MON->m_size.x)
+            continue; // parked off-screen
+        if (!m_dockFront || POS.x > m_dockFront->position(Desktop::View::IGeometric::GEOMETRIC_GOAL).x)
+            m_dockFront = w;
+    }
 }
 
