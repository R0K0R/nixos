 void CMoveTrackpadGesture::end(const ITrackpadGesture::STrackpadGestureEnd& e) {
 
+    if (m_dockSwipe) {
+        // Release: `<gestures:dock_swipe_exec> <l|r|none> <front address>`. A clearly
+        // horizontal swipe of 60px+ cycles (l/r = finger direction); anything shorter
+        // springs back. The front is the one captured at begin, since the drag has
+        // since moved every card.
+        static auto PDOCKEXEC = CConfigValue<Config::STRING>("gestures:dock_swipe_exec");
+        m_dockSwipe           = false;
+        const std::string CMD = *PDOCKEXEC;
+        const auto        FRONT = m_dockFront.lock();
+        m_dockCards.clear();
+        m_dockFront.reset();
+        if (CMD.empty() || CMD == STRVAL_EMPTY)
+            return;
+        const char* dir = (std::abs(m_lastDelta.x) >= 60.F && std::abs(m_lastDelta.x) > std::abs(m_lastDelta.y)) ? (m_lastDelta.x > 0 ? "r" : "l") : "none";
+        Config::Supplementary::executor()->spawnRaw(std::format("{} {} {}", CMD, dir, FRONT ? std::format("0x{:x}", rc<uintptr_t>(FRONT.get())) : std::string{""}));
+        return;
+    }
+
     if (!m_window)
         return;
 
