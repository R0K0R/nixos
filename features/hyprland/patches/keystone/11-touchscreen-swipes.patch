+#include <algorithm>
+#include <optional>
+#include <unordered_map>
+#include <vector>
+
+/*
+  Touchscreen swipes as TRACKPAD gestures: the touch path synthesizes swipe begin /
+  update / end into g_pTrackpadGestures, the same dispatcher libinput's touchpad swipes
+  feed, so the configured hl.gesture entries run live for touch exactly as they do on the
+  touchpad. The delta is the touch centroid's travel in logical px (times
+  gestures:touch_swipe_scale), in finger direction like libinput's -- with the default
+  gestures:workspace_swipe_invert the content follows the fingers. Two entries:
+
+  - 4 fingers: once exactly four are down and their centroid has travelled
+    gestures:touch_swipe_threshold px -> a 4-finger swipe (the column walk with its
+    workspace handoff, scroll_move).
+  - 3 fingers, double-tap-then-drag: a 3-finger tap (all up within
+    gestures:touch_move_tap_ms, none moved past gestures:touch_move_slop), then three
+    fingers down again within gestures:touch_move_gap_ms -> a 3-finger swipe from the
+    third finger on, i.e. the `move` gesture: a window follows the fingers, a side-dock
+    card swipes and gestures:dock_swipe_exec settles it. A plain 3-finger swipe stays
+    the client's.
+
+  From the start the gesture's touches are cancelled for the client. Lifting a finger
+  ends it; another finger landing cancels it.
+*/
+namespace {
+    struct STouchSwipeState {
+        struct SPoint {
+            Vector2D start, last;
+        };
+        std::unordered_map<int32_t, SPoint> points; // every finger currently down
+        size_t                              maxFingers = 0;
+        uint32_t                            seqStartMs = 0;
+        bool                                seqMoved   = false;
+        bool                                seqGesture = false; // this sequence became a gesture
+        std::optional<uint32_t>             lastTapEndMs;       // a qualifying 3-finger tap ended
+
+        bool                                pending4 = false; // four down, waiting for the threshold
+        Vector2D                            pendingStart;
+
+        bool                                active  = false;
+        uint32_t                            fingers = 0;
+        std::vector<int32_t>                ids;         // the gesture's fingers, swallowed until lifted
+        std::optional<int32_t>              undelivered; // the finger that started it never reached the client
+        Vector2D                            lastCentroid;
+    };
+    STouchSwipeState g_touchSwipe;
+
+    bool isGestureFinger(int32_t id) {
+        return std::ranges::find(g_touchSwipe.ids, id) != g_touchSwipe.ids.end();
+    }
+
+    Vector2D centroidOf(const std::vector<int32_t>& ids) {
+        Vector2D sum;
+        size_t   n = 0;
+        for (const auto id : ids) {
+            if (const auto it = g_touchSwipe.points.find(id); it != g_touchSwipe.points.end()) {
+                sum = sum + it->second.last;
+                n++;
+            }
+        }
+        return n ? sum / sc<double>(n) : g_touchSwipe.lastCentroid;
+    }
+
+    std::vector<int32_t> allDown() {
+        std::vector<int32_t> ids;
+        for (auto const& [id, _] : g_touchSwipe.points)
+            ids.push_back(id);
+        return ids;
+    }
+
+    void swipeUpdate(uint32_t timeMs, const Vector2D& delta) {
+        static auto                       PSCALE = CConfigValue<Config::FLOAT>("gestures:touch_swipe_scale");
+        const IPointer::SSwipeUpdateEvent UPDATE = {.timeMs = timeMs, .fingers = g_touchSwipe.fingers, .delta = delta * sc<double>(*PSCALE)};
+        g_pTrackpadGestures->gestureUpdate(UPDATE);
+    }
+
+    // take the current fingers from the client and start a synthetic swipe
+    void swipeBegin(uint32_t timeMs, uint32_t fingers, const Vector2D& centroid) {
+        auto& S        = g_touchSwipe;
+        S.active       = true;
+        S.seqGesture   = true;
+        S.pending4     = false;
+        S.fingers      = fingers;
+        S.ids          = allDown();
+        S.lastCentroid = centroid;
+        g_pSeatManager->sendTouchCancel();
+        // these deltas are logical finger travel, not physical: the dock swipe converts them
+        g_pTrackpadGestures->m_fromTouchscreen = true;
+        g_pTrackpadGestures->gestureBegin(IPointer::SSwipeBeginEvent{.timeMs = timeMs, .fingers = fingers});
+    }
+
+    void swipeEnd(uint32_t timeMs, bool cancelled) {
+        g_touchSwipe.active = false;
+        g_pTrackpadGestures->gestureEnd(IPointer::SSwipeEndEvent{.timeMs = timeMs, .cancelled = cancelled});
+        g_pTrackpadGestures->m_fromTouchscreen = false;
+    }
+}
 
