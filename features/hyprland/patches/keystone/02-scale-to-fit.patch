+        static auto PPIPZOOM = CConfigValue<Config::FLOAT>("decoration:keystone_pip_zoom");
+        const auto  BOX      = m_realSize->goal();
+        if (BOX.x > 0 && BOX.y > 0)
+            return (BOX * std::clamp(sc<double>(*PPIPZOOM), 1.0, 8.0)).round();
