# Local nix-build / nixos-rebuild symlink
result
result-*

# OpenVPN profiles, keys, credentials (never commit)
secrets/

# Local notes and findings
galaxybook-thermal-findings.md
victus-thermal-findings.md
claude-desktop-blackening-findings.md

# Personal Claude Code permission allowlist (session-specific store paths, IPs) — not shared
.claude/settings.local.json

# Runtime-cache: generated, regenerated on demand by runtime-cache-refresh.sh.
# Kept out of routine `git add -A`/status noise; the refresh script re-adds
# these explicitly (with -f) after writing them so a dirty-tree, non-impure
# eval still sees the freshest cache instead of falling through to Tier 3.
modules/nixos/nix/runtime-cache/aliasable.nix
modules/nixos/nix/runtime-cache/tier1/*.nix
modules/nixos/nix/runtime-cache/tier2/*.nix
