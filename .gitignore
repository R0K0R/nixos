# Local nix-build / nixos-rebuild symlink
result
result-*

# OpenVPN profiles, keys, credentials (never commit)
secrets/

# Local notes and findings
galaxybook-thermal-findings.md
victus-thermal-findings.md
claude-desktop-blackening-findings.md

# Personal Claude Code permission allowlist (session-specific store paths, IPs) — not shared
.claude/settings.local.json

# NOTE: modules/nixos/nix/runtime-cache/{aliasable,tier1/*,tier2/*}.nix are
# deliberately NOT ignored. They are generated, but nixos-rebuild evaluates the
# flake through git and only sees tracked files -- an ignored cache file is
# written successfully, reported as written, and then silently ignored by the
# rebuild, which falls through to Tier 3 with no error. Ignoring them required
# `git add -f` on every host after every refresh; one forgotten flag silently
# degraded the classifier. Tracking them costs diff noise and nothing else.
